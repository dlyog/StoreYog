# All AI integrations are optional. Default demo runs real MCP and SQLite locally.
DEMO_MODE=true
PORT=3100
MCP_PORT=3101
PUBLIC_MCP_PORT=3102
APP_BIND=127.0.0.1
PUBLIC_MCP_BIND=127.0.0.1
STORE_TIMEZONE=America/Los_Angeles
STORE_OWNER_EMAIL=owner@example.test
# setup.py selects available ports and generates local connection URLs.

# OpenAI-compatible chat: base origin OR a base ending in /v1.
LLM_API=
LLM_API_KEY=
TRAINIUM_LLM_MODEL=

# Custom Whisper: POST /transcribe, multipart audio, JSON transcription.
# OpenAI format: POST /v1/audio/transcriptions, file+model, JSON text.
STP_API=
STT_API_KEY=
STT_API_FORMAT=whisper
STT_MODEL=whisper-1

# Custom Kokoro: POST /generate-audio-binary/, text+voice+speed, WAV.
# OpenAI format: POST /v1/audio/speech, model+input+voice, audio response.
TTS_API=
TTS_API_KEY=
TTS_API_FORMAT=kokoro
TRAINIUM_TTS_VOICE=af_heart
TTS_MODEL=tts-1
TTS_VOICE=alloy
LAB_HTTP_TRANSPORT=fetch

# Email is optional and OFF unless you configure a transport and verified recipient.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=
# INVENTORY_REPORT_TO=
# STORE_PARTNER_EMAIL=
# PYTHON_BIN=python3
